{
  "name": "homeborismygitslovo",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware --max-warnings 0 src scripts tests vite.config.ts vitest.config.ts",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "check:compiler": "node --test scripts/check-compiler.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:rust": "sh scripts/coverage-rust.sh",
    "tauri": "tauri",
    "build:helper:dev": "node scripts/build-helper.js --debug",
    "build:helper": "node scripts/build-helper.js --release",
    "dev:linux": "tauri dev --config src-tauri/tauri.linux.conf.json",
    "build:linux": "tauri build --config src-tauri/tauri.linux.conf.json",
    "setup:ubuntu": "sudo install -Dm644 src-tauri/resources/72-slovo-input-helper.rules /usr/lib/udev/rules.d/72-slovo-input-helper.rules && sudo udevadm control --reload-rules && sudo udevadm trigger --subsystem-match=input --action=change"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-radio-group": "^1.4.4",
    "@radix-ui/react-select": "^2.3.4",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "24.1.3",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "3.2.7"
  }
}
