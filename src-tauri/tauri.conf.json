{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slovo",
  "version": "0.1.0",
  "identifier": "com.slovo.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Слово — Настройки диктовки",
        "width": 560,
        "height": 470,
        "minWidth": 360,
        "minHeight": 430,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "recording-overlay",
        "url": "recording.html",
        "width": 184,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
